<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- EF migrations and model snapshots are generated code. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <!-- Package coverage is measured by Shared/tests; keep this report service-only. -->
          <Exclude>[UserManagement.*]*,[AccessControl.Client]*,[AccessControl.Contracts]*,[Common.Persistence]*,[AdminManagement.Security]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
