          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "description": "Lists all registered entitlements, including inactive and unreferenced entries, ordered by unit organization ID, code, and entitlement ID. SuperAdmin for a tenant-wide list or search; Admin for an assigned unit organization.",
        "responses": {
          "200": {
            "description": "Page of registered entitlements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementPageResponse"
                },
                "example": {
                  "items": [
                    {
                      "id": "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
                      "tenantId": "default",
                      "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                      "code": "customers.view",
                      "displayName": "View customers",
                      "isActive": true
                    }
                  ],
                  "totalCount": 1,
                  "page": 1,
                  "pageSize": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        }
      },
      "post": {
        "tags": [
          "Administration"
        ],
