          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        },
        "description": "Admin for the selected unit organization."
      },
      "put": {
        "tags": [
          "Role entitlements"
        ],
        "summary": "Replace all entitlements granted to a role",
        "description": "Replace the full entitlement set for one tenant and role ID. [] revokes all grants. Use the role ID returned by User Management. Admin for the selected unit organization.",
        "operationId": "replaceRoleEntitlements",
        "security": [
          {
            "AdminApiKey": [],
