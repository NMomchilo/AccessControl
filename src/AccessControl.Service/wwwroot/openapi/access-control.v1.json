    "/v1/entitlements/{id}/display-name": {
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Change an entitlement's display name",
        "description": "Changes only the human-readable name in the selected tenant and unit organization. The entitlement ID, code, status, grants, policies, and authorization revision remain unchanged. Admin for the selected unit organization.",
        "operationId": "updateEntitlementDisplayName",
        "security": [
          {
            "AdminApiKey": [],
            "EntraAdminBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEntitlementDisplayNameRequest"
              },
              "example": {
                "displayName": "View customer records"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated entitlement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementInfo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Entitlement not found in the selected scope"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        }
      }
    },
    "/v1/entitlements/{id}/active": {
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Activate or deactivate an entitlement",
        "operationId": "setEntitlementActive",
        "security": [
          {
            "AdminApiKey": [],
            "EntraAdminBearer": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetEntitlementActiveRequest"
              },
              "example": {
                "isActive": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status changed; authorization caches are invalidated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "404": {
            "description": "Entitlement not found in the selected scope"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        },
        "description": "Admin for the selected unit organization."
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DecisionApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Control-Key",
        "description": "Per-client decision credential. The consuming API supplies tenant, unit organization, and module. Startup catalog registration requires CanRegisterCatalog on the existing client."
      },
      "AdminApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Control-Key",
        "description": "Administrator service credential, used together with a validated Entra access token."
      },
      "EntraAdminBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Entra access token for the configured administrator API audience; current management duty is checked in User Management."
      },
      "DecisionEntraBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Validated Entra access token whose oid must match subjectId for a non-anonymous decision."
      }
    },
    "parameters": {
      "TenantId": {
        "name": "tenantId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "example": "default"
      },
      "Module": {
        "name": "module",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "example": "customers"
      },
      "HttpMethod": {
        "name": "httpMethod",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 16
        },
        "example": "GET"
      },
      "RouteTemplate": {
        "name": "routeTemplate",
        "in": "query",
        "required": true,
        "description": "ASP.NET Core route template, not a concrete request path.",
        "schema": {
          "type": "string",
          "maxLength": 512
        },
        "example": "/customers/{id}"
      },
      "RoleId": {
        "name": "roleId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "b78650b4-c248-cab1-3d80-9a7c0dad7059"
      },
      "UnitOrganizationId": {
        "name": "unitOrganizationId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "33333333-3333-3333-3333-333333333333"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "default": 1
        },
        "example": 1
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        },
        "example": 100
      },
      "OrganizationPathId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "33333333-3333-3333-3333-333333333333"
      }
    },
    "schemas": {
      "DecisionRequest": {
        "type": "object",
        "required": [
          "module",
          "httpMethod",
          "routeTemplate",
          "tenantId",
          "unitOrganizationId"
        ],
        "properties": {
          "subjectId": {
            "type": "string",
            "nullable": true,
            "description": "Validated Entra oid matching the forwarded bearer token; null for an anonymous public request.",
            "example": "alice"
          },
          "module": {
            "type": "string",
            "example": "customers"
          },
          "httpMethod": {
            "type": "string",
            "example": "GET"
          },
          "routeTemplate": {
            "type": "string",
            "example": "/customers/{id}"
          },
          "tenantId": {
            "type": "string",
            "example": "default"
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "Trusted gateway unit organization ID. All-zero is reserved for global public decisions.",
            "example": "33333333-3333-3333-3333-333333333333"
          },
          "roleIds": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Role IDs from the authenticated User Management identity for this tenant and unit organization. Empty or omitted for anonymous public decisions and administrative duty overrides."
          },
          "isSuperAdmin": {
            "type": "boolean",
            "default": false,
            "description": "Client-asserted tenant SuperAdmin duty. A valid decision key and matching bearer token make this sufficient to permit an existing protected policy in the selected UO."
          },
          "isUnitAdmin": {
            "type": "boolean",
            "default": false,
            "description": "Client-asserted Admin duty for the selected UO. A valid decision key and matching bearer token make this sufficient to permit an existing protected policy there."
          }
        }
      },
      "DecisionResponse": {
        "type": "object",
        "required": [
          "permit",
          "reason",
          "authenticationRequired"
        ],
        "properties": {
          "permit": {
            "type": "boolean",
            "description": "Whether the endpoint may continue."
          },
          "reason": {
            "type": "string",
            "description": "Reason for the decision."
          },
          "authenticationRequired": {
            "type": "boolean",
            "description": "True when an anonymous caller has no matching global public policy and must authenticate."
          }
        }
      },
      "PolicyKeyRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "module",
          "httpMethod",
          "routeTemplate",
          "unitOrganizationId"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default"
          },
          "module": {
            "type": "string",
            "maxLength": 128,
            "example": "customers"
          },
          "httpMethod": {
            "type": "string",
            "maxLength": 16,
            "example": "GET"
          },
          "routeTemplate": {
            "type": "string",
            "maxLength": 512,
            "example": "/customers/{id}"
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "UO ID validated through User Management. All-zero ID is reserved for global public policies and anonymous decisions.",
            "example": "33333333-3333-3333-3333-333333333333"
          }
        }
      },
      "PolicyRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PolicyKeyRequest"
          },
          {
            "type": "object",
            "required": [
              "isPublic",
              "requiredEntitlementIds"
            ],
            "properties": {
              "isPublic": {
                "type": "boolean",
                "description": "True allows access without a subject or role grant."
              },
              "requiredEntitlementIds": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Empty for public policies; 1-32 active entitlement IDs in this tenant and unit organization for protected policies. Any one matching grant permits access."
              }
            }
          }
        ]
      },
      "RoleEntitlementsRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "roleId",
          "entitlementIds",
          "unitOrganizationId"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default"
          },
          "entitlementIds": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "example": [
              "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
            ]
          },
          "roleId": {
            "type": "string",
            "format": "uuid",
            "example": "b78650b4-c248-cab1-3d80-9a7c0dad7059"
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "UO ID validated through User Management. All-zero ID is reserved for global public policies and anonymous decisions.",
            "example": "33333333-3333-3333-3333-333333333333"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EntitlementPageResponse": {
        "type": "object",
        "required": [
          "items",
          "totalCount",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntitlementInfo"
            }
          },
          "totalCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "CreateEntitlementRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "unitOrganizationId",
          "code",
          "displayName"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "PolicyPageResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "pageSize",
          "totalCount"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PolicyRequest"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          },
          "totalCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "EntitlementInfo": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "unitOrganizationId",
          "code",
          "displayName",
          "isActive"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "maxLength": 128
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "UpdateEntitlementDisplayNameRequest": {
        "type": "object",
        "required": [
          "displayName"
        ],
        "properties": {
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      },
      "SetEntitlementActiveRequest": {
        "type": "object",
        "required": [
          "isActive"
        ],
        "properties": {
          "isActive": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid API key or administrator actor bearer token"
      },
      "ServiceError": {
        "description": "Service or database error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Forbidden": {
        "description": "The authenticated administrator lacks the required tenant, unit organization, or SuperAdmin scope"
      },
      "AdminLookupUnavailable": {
        "description": "User Management could not verify current administrator duties",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
