{
  "openapi": "3.0.3",
  "info": {
    "title": "Access Control Service API",
    "version": "6.0.0",
    "description": "Tenant and unit-organization scoped endpoint decisions and administrator management. Administrator requests require an API key, signed actor bearer token, and current User Management scope. Database writes require a validated actor ID; a missing actor causes the write to fail."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as Swagger UI (local HTTP or HTTPS Development profile)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness check"
    },
    {
      "name": "Decisions",
      "description": "Authorization decisions for consuming services"
    },
    {
      "name": "Policies",
      "description": "Administrator endpoint policy management"
    },
    {
      "name": "Role entitlements",
      "description": "Administrator role grant management"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check whether the service process responds",
        "description": "This is a liveness response; it does not check database readiness.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service process is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": ["Health"],
        "summary": "Check database readiness",
        "description": "Returns 200 when the service can connect to its database and 503 otherwise. This endpoint does not check pending migrations.",
        "operationId": "getReady",
        "security": [],
        "responses": {
          "200": {
            "description": "Database connection is available",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {
                    "status": { "type": "string", "example": "ready" }
                  }
                }
              }
            }
          },
          "503": { "description": "Database connection is unavailable" }
        }
      }
    },
    "/v1/registrations/catalog": {
      "post": {
        "tags": ["Decisions"],
        "summary": "Register a consuming API module and its discovered endpoints",
        "description": "Uses the existing decision client key when CanRegisterCatalog is enabled. The consuming API supplies tenant, unit organization, and module; a registration-enabled key may register any of them. The configured ClientId identifies the write actor. Creates a missing active module and protected policies with no entitlements. An administrator may later edit a registered policy, including setting isPublic to true through PUT /v1/policies. Subsequent registration never overwrites that edit. Call after User Management organization registration.",
        "operationId": "registerEndpointCatalog",
        "security": [{"DecisionApiKey": []}],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "required": ["tenantId", "unitOrganizationId", "module", "moduleName", "endpoints"],
            "properties": {
              "tenantId": {"type": "string", "maxLength": 128},
              "unitOrganizationId": {"type": "string", "format": "uuid"},
              "module": {"type": "string", "maxLength": 128},
              "moduleName": {"type": "string", "maxLength": 200},
              "endpoints": {"type": "array", "maxItems": 1000, "items": {"type": "object", "required": ["httpMethod", "routeTemplate"], "properties": {
                "httpMethod": {"type": "string", "maxLength": 16},
                "routeTemplate": {"type": "string", "maxLength": 512}
              }}}
            }
          }}}
        },
        "responses": {
          "200": {"description": "Registration counts returned; existing module and policies preserved"},
          "400": {"description": "Invalid catalog"},
          "401": {"description": "Invalid client key"},
          "403": {"description": "Registration is not enabled for this client"},
          "409": {"description": "Module name differs or module is inactive"}
        }
      }
    },
    "/v1/decisions": {
      "post": {
        "tags": [
          "Decisions"
        ],
        "summary": "Evaluate one endpoint request",
        "description": "Find an active endpoint policy first; no policy denies and public policies permit. For a protected policy, an authenticated caller with isSuperAdmin or isUnitAdmin is permitted before role entitlements are evaluated. SuperAdmin applies to every active UO in the user's application tenant; unit Admin applies only to the selected UO. The decision client key is trusted to assert role IDs and duty flags; Access Control does not independently verify those flags with User Management. Non-null subjectId requires a matching validated Entra bearer token. A valid key may request any tenant, unit organization, and module.",
        "operationId": "decideAccess",
        "security": [
          {
            "DecisionApiKey": []
          },
          {
            "DecisionApiKey": [],
            "DecisionEntraBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              },
              "example": {
                "subjectId": "9155ff4d-2708-4770-b87e-e238645ec5df",
                "module": "customers",
                "httpMethod": "GET",
                "routeTemplate": "/customers/{id}",
                "tenantId": "default",
                "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                "roleIds": [
                  "c4227c8a-16ef-eb3c-aedb-8197bf7f39c2"
                ],
                "isSuperAdmin": false,
                "isUnitAdmin": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization result, including denials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                },
                "examples": {
                  "permit": {
                    "value": {
                      "permit": true,
                      "reason": "Permit",
                      "authenticationRequired": false
                    }
                  },
                  "deny": {
                    "value": {
                      "permit": false,
                      "reason": "Required entitlement missing",
                      "authenticationRequired": false
                    }
                  },
                  "anonymousProtected": {
                    "value": {
                      "permit": false,
                      "reason": "Authentication required",
                      "authenticationRequired": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "description": "Decision client is not allowed to assert the requested unit organization."
          },
          "503": {
            "description": "Decision service or persistence is unavailable."
          }
        }
      }
    },
    "/v1/policies/search": {
      "get": {
        "tags": [
          "Policies"
        ],
        "summary": "Search endpoint policies",
        "description": "Lists policies in one tenant. Optional filters narrow by unit organization, module, and HTTP method. The all-zero unit organization ID selects global public policies. SuperAdmin for a tenant-wide list or search; Admin for an assigned unit organization. Inactive policies are excluded.",
        "operationId": "searchPolicies",
        "security": [
          {
            "AdminApiKey": [],
            "EntraAdminBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "name": "unitOrganizationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "module",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 128
            }
          },
          {
            "name": "httpMethod",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 16
            }
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of policies",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyPageResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        }
      }
    },
    "/v1/policies": {
      "get": {
        "tags": [
          "Policies"
        ],
        "summary": "Get an endpoint policy",
        "operationId": "getPolicy",
        "security": [
          {
            "AdminApiKey": [],
            "EntraAdminBearer": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          },
          {
            "$ref": "#/components/parameters/Module"
          },
          {
            "$ref": "#/components/parameters/HttpMethod"
          },
          {
            "$ref": "#/components/parameters/RouteTemplate"
          }
        ],
        "responses": {
          "200": {
            "description": "Policy found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No policy for this endpoint"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        },
        "description": "Admin for the selected unit organization; SuperAdmin for a global public policy. Inactive policies return 404."
      },
      "put": {
        "tags": [
          "Policies"
        ],
        "summary": "Create or replace an endpoint policy",
        "description": "Protected policies require nonzero UO ID and entitlements. All-zero UO ID is reserved for a global public policy. A UO-specific policy takes precedence over the global public fallback. Admin for the selected unit organization; SuperAdmin for a global public policy. Upserting an inactive key reactivates the policy.",
        "operationId": "upsertPolicy",
        "security": [
          {
            "AdminApiKey": [],
            "EntraAdminBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyRequest"
              },
              "examples": {
                "protected": {
                  "value": {
                    "tenantId": "default",
                    "module": "customers",
                    "httpMethod": "GET",
                    "routeTemplate": "/customers/{id}",
                    "isPublic": false,
                    "requiredEntitlementIds": [
                      "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
                    ],
                    "unitOrganizationId": "33333333-3333-3333-3333-333333333333"
                  }
                },
                "public": {
                  "value": {
                    "tenantId": "default",
                    "module": "customers",
                    "httpMethod": "GET",
                    "routeTemplate": "/customers/public",
                    "isPublic": true,
                    "requiredEntitlementIds": [],
                    "unitOrganizationId": "00000000-0000-0000-0000-000000000000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Policy saved"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        }
      },
      "delete": {
        "tags": [
          "Policies"
        ],
        "summary": "Deactivate an endpoint policy",
        "operationId": "deletePolicy",
        "security": [
          {
            "AdminApiKey": [],
            "EntraAdminBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyKeyRequest"
              },
              "example": {
                "tenantId": "default",
                "module": "customers",
                "httpMethod": "GET",
                "routeTemplate": "/customers/{id}",
                "unitOrganizationId": "33333333-3333-3333-3333-333333333333"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Delete completed, including when the policy did not exist"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        },
        "description": "Admin for the selected unit organization; SuperAdmin for a global public policy. The row is retained but excluded from decisions and administrator reads; the revision advances to invalidate caches. A later PUT with the same key restores it."
      }
    },
