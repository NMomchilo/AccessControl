          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "503": {
            "$ref": "#/components/responses/AdminLookupUnavailable"
          }
        }
      }
    },
    "/v1/entitlements": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List entitlements in a tenant",
        "operationId": "listEntitlements",
        "security": [
