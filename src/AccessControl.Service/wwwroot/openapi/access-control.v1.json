{
  "openapi": "3.0.3",
  "info": {
    "title": "Access Control Service API",
    "version": "5.1.0",
    "description": "Tenant and unit-organization scoped endpoint decisions and administration."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as Swagger UI (local HTTP or HTTPS Development profile)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness check"
    },
    {
      "name": "Decisions",
      "description": "Authorization decisions for consuming services"
    },
    {
      "name": "Policies",
      "description": "Administrator endpoint policy management"
    },
    {
      "name": "Role entitlements",
      "description": "Administrator role grant management"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check whether the service process responds",
        "description": "This is a liveness response; it does not check database readiness.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service process is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/decisions": {
      "post": {
        "tags": [
          "Decisions"
        ],
        "summary": "Evaluate one endpoint request",
        "description": "Returns HTTP 200 for permit and deny. The consuming API forwards a validated oid and role IDs supplied by User Management. This service trusts those assertions and does not validate the end-user JWT.",
        "operationId": "decideAccess",
        "security": [
          {
            "DecisionApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              },
              "example": {
                "subjectId": "9155ff4d-2708-4770-b87e-e238645ec5df",
                "roleIds": [
                  "b78650b4-c248-cab1-3d80-9a7c0dad7059"
                ],
                "module": "customers",
                "httpMethod": "GET",
                "routeTemplate": "/customers/{id}",
                "tenantId": "default",
                "unitOrganizationId": "33333333-3333-3333-3333-333333333333"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization result, including denials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                },
                "examples": {
                  "permit": {
                    "value": {
                      "permit": true,
                      "reason": "Permit",
                      "authenticationRequired": false
                    }
                  },
                  "deny": {
                    "value": {
                      "permit": false,
                      "reason": "Required entitlement missing",
                      "authenticationRequired": false
                    }
                  },
                  "anonymousProtected": {
                    "value": {
                      "permit": false,
                      "reason": "Authentication required",
                      "authenticationRequired": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/policies": {
      "get": {
        "tags": [
          "Policies"
        ],
        "summary": "Get an endpoint policy",
        "operationId": "getPolicy",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          },
          {
            "$ref": "#/components/parameters/Module"
          },
          {
            "$ref": "#/components/parameters/HttpMethod"
          },
          {
            "$ref": "#/components/parameters/RouteTemplate"
          }
        ],
        "responses": {
          "200": {
            "description": "Policy found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No policy for this endpoint"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "put": {
        "tags": [
          "Policies"
        ],
        "summary": "Create or replace an endpoint policy",
        "description": "Protected policies require nonzero UO ID and entitlements. All-zero UO ID is reserved for a global public policy. A UO-specific policy takes precedence over the global public fallback.",
        "operationId": "upsertPolicy",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyRequest"
              },
              "examples": {
                "protected": {
                  "value": {
                    "tenantId": "default",
                    "module": "customers",
                    "httpMethod": "GET",
                    "routeTemplate": "/customers/{id}",
                    "isPublic": false,
                    "requiredEntitlementIds": [
                      "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
                    ],
                    "unitOrganizationId": "33333333-3333-3333-3333-333333333333"
                  }
                },
                "public": {
                  "value": {
                    "tenantId": "default",
                    "module": "customers",
                    "httpMethod": "GET",
                    "routeTemplate": "/customers/public",
                    "isPublic": true,
                    "requiredEntitlementIds": [],
                    "unitOrganizationId": "00000000-0000-0000-0000-000000000000"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Policy saved"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "delete": {
        "tags": [
          "Policies"
        ],
        "summary": "Delete an endpoint policy",
        "operationId": "deletePolicy",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyKeyRequest"
              },
              "example": {
                "tenantId": "default",
                "module": "customers",
                "httpMethod": "GET",
                "routeTemplate": "/customers/{id}",
                "unitOrganizationId": "33333333-3333-3333-3333-333333333333"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Delete completed, including when the policy did not exist"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/roles/entitlements": {
      "get": {
        "tags": [
          "Role entitlements"
        ],
        "summary": "Get all entitlements granted to a role",
        "operationId": "getRoleEntitlements",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          },
          {
            "$ref": "#/components/parameters/RoleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Role grants; entitlements is empty when none are granted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleEntitlementsRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "put": {
        "tags": [
          "Role entitlements"
        ],
        "summary": "Replace all entitlements granted to a role",
        "description": "Replace the full entitlement set for one tenant and role ID. [] revokes all grants. Use the role ID returned by User Management.",
        "operationId": "replaceRoleEntitlements",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleEntitlementsRequest"
              },
              "example": {
                "tenantId": "default",
                "roleId": "b78650b4-c248-cab1-3d80-9a7c0dad7059",
                "entitlementIds": [
                  "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
                ],
                "unitOrganizationId": "33333333-3333-3333-3333-333333333333"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Role grants replaced"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/entitlements": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List entitlements in a tenant",
        "operationId": "listEntitlements",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "description": "Lists all registered entitlements, including inactive and unreferenced entries, ordered by unit organization ID, code, and entitlement ID.",
        "responses": {
          "200": {
            "description": "Page of registered entitlements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementPageResponse"
                },
                "example": {
                  "items": [
                    {
                      "id": "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
                      "tenantId": "default",
                      "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                      "code": "customers.view",
                      "displayName": "View customers",
                      "isActive": true
                    }
                  ],
                  "totalCount": 1,
                  "page": 1,
                  "pageSize": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "post": {
        "tags": [
          "Administration"
        ],
        "summary": "Create an entitlement",
        "operationId": "createEntitlement",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEntitlementRequest"
              },
              "example": {
                "tenantId": "default",
                "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                "code": "customers.view",
                "displayName": "View customers"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Entitlement created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementInfo"
                },
                "example": {
                  "id": "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
                  "tenantId": "default",
                  "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                  "code": "customers.view",
                  "displayName": "View customers",
                  "isActive": true
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "409": {
            "description": "Code already exists in this tenant and unit organization"
          }
        }
      }
    },
    "/v1/unit-organizations/{id}/entitlements": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List entitlements in one unit organization",
        "operationId": "listUnitOrganizationEntitlements",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationPathId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "description": "Lists all registered entitlements, including inactive and unreferenced entries, ordered by unit organization ID, code, and entitlement ID.",
        "responses": {
          "200": {
            "description": "Page of registered entitlements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EntitlementPageResponse"
                },
                "example": {
                  "items": [
                    {
                      "id": "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa",
                      "tenantId": "default",
                      "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                      "code": "customers.view",
                      "displayName": "View customers",
                      "isActive": true
                    }
                  ],
                  "totalCount": 1,
                  "page": 1,
                  "pageSize": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/entitlements/{id}/display-name": {
      "put": {
        "tags": ["Administration"],
        "summary": "Change an entitlement's display name",
        "description": "Changes only the human-readable name in the selected tenant and unit organization. The entitlement ID, code, status, grants, policies, and authorization revision remain unchanged.",
        "operationId": "updateEntitlementDisplayName",
        "security": [{ "AdminApiKey": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          },
          { "$ref": "#/components/parameters/TenantId" },
          { "$ref": "#/components/parameters/UnitOrganizationId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateEntitlementDisplayNameRequest" },
              "example": { "displayName": "View customer records" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated entitlement",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/EntitlementInfo" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Entitlement not found in the selected scope" },
          "500": { "$ref": "#/components/responses/ServiceError" }
        }
      }
    },
    "/v1/entitlements/{id}/active": {
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Activate or deactivate an entitlement",
        "operationId": "setEntitlementActive",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetEntitlementActiveRequest"
              },
              "example": {
                "isActive": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status changed; authorization caches are invalidated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "404": {
            "description": "Entitlement not found in the selected scope"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DecisionApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Control-Key",
        "description": "Use ApiKeys:DecisionKey for POST /v1/decisions."
      },
      "AdminApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Control-Key",
        "description": "Use ApiKeys:AdminKey for policy and role administration."
      }
    },
    "parameters": {
      "TenantId": {
        "name": "tenantId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "example": "default"
      },
      "Module": {
        "name": "module",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "example": "customers"
      },
      "HttpMethod": {
        "name": "httpMethod",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 16
        },
        "example": "GET"
      },
      "RouteTemplate": {
        "name": "routeTemplate",
        "in": "query",
        "required": true,
        "description": "ASP.NET Core route template, not a concrete request path.",
        "schema": {
          "type": "string",
          "maxLength": 512
        },
        "example": "/customers/{id}"
      },
      "RoleId": {
        "name": "roleId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "b78650b4-c248-cab1-3d80-9a7c0dad7059"
      },
      "UnitOrganizationId": {
        "name": "unitOrganizationId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "33333333-3333-3333-3333-333333333333"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "default": 1
        },
        "example": 1
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        },
        "example": 100
      },
      "OrganizationPathId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "33333333-3333-3333-3333-333333333333"
      }
    },
    "schemas": {
      "DecisionRequest": {
        "type": "object",
        "required": [
          "roleIds",
          "module",
          "httpMethod",
          "routeTemplate",
          "tenantId",
          "unitOrganizationId"
        ],
        "properties": {
          "subjectId": {
            "type": "string",
            "nullable": true,
            "description": "The validated Entra JWT oid claim, or null for an anonymous request.",
            "example": "alice"
          },
          "module": {
            "type": "string",
            "example": "customers"
          },
          "httpMethod": {
            "type": "string",
            "example": "GET"
          },
          "routeTemplate": {
            "type": "string",
            "example": "/customers/{id}"
          },
          "tenantId": {
            "type": "string",
            "example": "default"
          },
          "roleIds": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Role IDs returned by User Management. Empty for anonymous callers."
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "UO ID validated through User Management. All-zero ID is reserved for global public policies and anonymous decisions.",
            "example": "33333333-3333-3333-3333-333333333333"
          }
        }
      },
      "DecisionResponse": {
        "type": "object",
        "required": [
          "permit",
          "reason",
          "authenticationRequired"
        ],
        "properties": {
          "permit": {
            "type": "boolean",
            "description": "Whether the endpoint may continue."
          },
          "reason": {
            "type": "string",
            "description": "Reason for the decision."
          },
          "authenticationRequired": {
            "type": "boolean",
            "description": "True when an anonymous caller has no matching global public policy and must authenticate."
          }
        }
      },
      "PolicyKeyRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "module",
          "httpMethod",
          "routeTemplate",
          "unitOrganizationId"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default"
          },
          "module": {
            "type": "string",
            "maxLength": 128,
            "example": "customers"
          },
          "httpMethod": {
            "type": "string",
            "maxLength": 16,
            "example": "GET"
          },
          "routeTemplate": {
            "type": "string",
            "maxLength": 512,
            "example": "/customers/{id}"
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "UO ID validated through User Management. All-zero ID is reserved for global public policies and anonymous decisions.",
            "example": "33333333-3333-3333-3333-333333333333"
          }
        }
      },
      "PolicyRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PolicyKeyRequest"
          },
          {
            "type": "object",
            "required": [
              "isPublic",
              "requiredEntitlementIds"
            ],
            "properties": {
              "isPublic": {
                "type": "boolean",
                "description": "True allows access without a subject or role grant."
              },
              "requiredEntitlementIds": {
                "type": "array",
                "maxItems": 32,
                "items": {
                  "type": "string",
                  "format": "uuid"
                },
                "description": "Empty for public policies; 1-32 active entitlement IDs in this tenant and unit organization for protected policies. Any one matching grant permits access."
              }
            }
          }
        ]
      },
      "RoleEntitlementsRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "roleId",
          "entitlementIds",
          "unitOrganizationId"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default"
          },
          "entitlementIds": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "example": [
              "11111111-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
            ]
          },
          "roleId": {
            "type": "string",
            "format": "uuid",
            "example": "b78650b4-c248-cab1-3d80-9a7c0dad7059"
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "UO ID validated through User Management. All-zero ID is reserved for global public policies and anonymous decisions.",
            "example": "33333333-3333-3333-3333-333333333333"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "EntitlementPageResponse": {
        "type": "object",
        "required": [
          "items",
          "totalCount",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EntitlementInfo"
            }
          },
          "totalCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "CreateEntitlementRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "unitOrganizationId",
          "code",
          "displayName"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "EntitlementInfo": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "unitOrganizationId",
          "code",
          "displayName",
          "isActive"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "maxLength": 128
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "maxLength": 128
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "UpdateEntitlementDisplayNameRequest": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "SetEntitlementActiveRequest": {
        "type": "object",
        "required": [
          "isActive"
        ],
        "properties": {
          "isActive": {
            "type": "boolean"
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or incorrect X-Access-Control-Key"
      },
      "ServiceError": {
        "description": "Service or database error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
