{
  "openapi": "3.0.3",
  "info": {
    "title": "Access Control Service API",
    "version": "2.0.0",
    "description": "Tenant-scoped endpoint policies and entitlement grants keyed by stable User Management role IDs. The consuming API forwards role IDs from User Management; Access Control does not store users."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as Swagger UI (local HTTP or HTTPS Development profile)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness check"
    },
    {
      "name": "Decisions",
      "description": "Authorization decisions for consuming services"
    },
    {
      "name": "Policies",
      "description": "Administrator endpoint policy management"
    },
    {
      "name": "Role entitlements",
      "description": "Administrator role grant management"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check whether the service process responds",
        "description": "This is a liveness response; it does not check database readiness.",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service process is running",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/decisions": {
      "post": {
        "tags": [
          "Decisions"
        ],
        "summary": "Evaluate one endpoint request",
        "description": "Returns HTTP 200 for permit and deny. The consuming API forwards a validated oid and role IDs supplied by User Management. This service trusts those assertions and does not validate the end-user JWT.",
        "operationId": "decideAccess",
        "security": [
          {
            "DecisionApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionRequest"
              },
              "example": {
                "subjectId": "9155ff4d-2708-4770-b87e-e238645ec5df",
                "roleIds": [
                  "b78650b4-c248-cab1-3d80-9a7c0dad7059"
                ],
                "module": "customers",
                "httpMethod": "GET",
                "routeTemplate": "/customers/{id}",
                "tenantId": "default"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Authorization result, including denials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DecisionResponse"
                },
                "examples": {
                  "permit": {
                    "value": {
                      "permit": true,
                      "reason": "Permit",
                      "authenticationRequired": false
                    }
                  },
                  "deny": {
                    "value": {
                      "permit": false,
                      "reason": "Required entitlement missing",
                      "authenticationRequired": false
                    }
                  },
                  "anonymousProtected": {
                    "value": {
                      "permit": false,
                      "reason": "Authentication required",
                      "authenticationRequired": true
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/policies": {
      "get": {
        "tags": [
          "Policies"
        ],
        "summary": "Get an endpoint policy",
        "operationId": "getPolicy",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/Module"
          },
          {
            "$ref": "#/components/parameters/HttpMethod"
          },
          {
            "$ref": "#/components/parameters/RouteTemplate"
          }
        ],
        "responses": {
          "200": {
            "description": "Policy found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PolicyRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No policy for this endpoint"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "put": {
        "tags": [
          "Policies"
        ],
        "summary": "Create or replace an endpoint policy",
        "description": "Public policies have no required entitlements. Protected policies require at least one. Method is normalized to uppercase; tenant, module, route template, and entitlements are normalized to lowercase.",
        "operationId": "upsertPolicy",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyRequest"
              },
              "examples": {
                "protected": {
                  "value": {
                    "tenantId": "default",
                    "module": "customers",
                    "httpMethod": "GET",
                    "routeTemplate": "/customers/{id}",
                    "isPublic": false,
                    "requiredEntitlements": [
                      "customers.view"
                    ]
                  }
                },
                "public": {
                  "value": {
                    "tenantId": "default",
                    "module": "customers",
                    "httpMethod": "GET",
                    "routeTemplate": "/customers/public",
                    "isPublic": true,
                    "requiredEntitlements": []
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Policy saved"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "delete": {
        "tags": [
          "Policies"
        ],
        "summary": "Delete an endpoint policy",
        "operationId": "deletePolicy",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyKeyRequest"
              },
              "example": {
                "tenantId": "default",
                "module": "customers",
                "httpMethod": "GET",
                "routeTemplate": "/customers/{id}"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Delete completed, including when the policy did not exist"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/roles/entitlements": {
      "get": {
        "tags": [
          "Role entitlements"
        ],
        "summary": "Get all entitlements granted to a role",
        "operationId": "getRoleEntitlements",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/RoleId"
          }
        ],
        "responses": {
          "200": {
            "description": "Role grants; entitlements is empty when none are granted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleEntitlementsRequest"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "put": {
        "tags": [
          "Role entitlements"
        ],
        "summary": "Replace all entitlements granted to a role",
        "description": "Replace the full entitlement set for one tenant and role ID. [] revokes all grants. Use the role ID returned by User Management.",
        "operationId": "replaceRoleEntitlements",
        "security": [
          {
            "AdminApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoleEntitlementsRequest"
              },
              "example": {
                "tenantId": "default",
                "roleId": "b78650b4-c248-cab1-3d80-9a7c0dad7059",
                "entitlements": [
                  "customers.view"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Role grants replaced"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "DecisionApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Control-Key",
        "description": "Use ApiKeys:DecisionKey for POST /v1/decisions."
      },
      "AdminApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Access-Control-Key",
        "description": "Use ApiKeys:AdminKey for policy and role administration."
      }
    },
    "parameters": {
      "TenantId": {
        "name": "tenantId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "example": "default"
      },
      "Module": {
        "name": "module",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "example": "customers"
      },
      "HttpMethod": {
        "name": "httpMethod",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "maxLength": 16
        },
        "example": "GET"
      },
      "RouteTemplate": {
        "name": "routeTemplate",
        "in": "query",
        "required": true,
        "description": "ASP.NET Core route template, not a concrete request path.",
        "schema": {
          "type": "string",
          "maxLength": 512
        },
        "example": "/customers/{id}"
      },
      "RoleId": {
        "name": "roleId",
        "in": "query",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "b78650b4-c248-cab1-3d80-9a7c0dad7059"
      }
    },
    "schemas": {
      "DecisionRequest": {
        "type": "object",
        "required": [
          "roleIds",
          "module",
          "httpMethod",
          "routeTemplate",
          "tenantId"
        ],
        "properties": {
          "subjectId": {
            "type": "string",
            "nullable": true,
            "description": "The validated Entra JWT oid claim, or null for an anonymous request.",
            "example": "alice"
          },
          "module": {
            "type": "string",
            "example": "customers"
          },
          "httpMethod": {
            "type": "string",
            "example": "GET"
          },
          "routeTemplate": {
            "type": "string",
            "example": "/customers/{id}"
          },
          "tenantId": {
            "type": "string",
            "example": "default"
          },
          "roleIds": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Role IDs returned by User Management. Empty for anonymous callers."
          }
        }
      },
      "DecisionResponse": {
        "type": "object",
        "required": [
          "permit",
          "reason",
          "authenticationRequired"
        ],
        "properties": {
          "permit": {
            "type": "boolean",
            "description": "Whether the endpoint may continue."
          },
          "reason": {
            "type": "string",
            "description": "Reason for the decision."
          },
          "authenticationRequired": {
            "type": "boolean",
            "description": "True when a protected endpoint received no subject ID."
          }
        }
      },
      "PolicyKeyRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "module",
          "httpMethod",
          "routeTemplate"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default"
          },
          "module": {
            "type": "string",
            "maxLength": 128,
            "example": "customers"
          },
          "httpMethod": {
            "type": "string",
            "maxLength": 16,
            "example": "GET"
          },
          "routeTemplate": {
            "type": "string",
            "maxLength": 512,
            "example": "/customers/{id}"
          }
        }
      },
      "PolicyRequest": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PolicyKeyRequest"
          },
          {
            "type": "object",
            "required": [
              "isPublic",
              "requiredEntitlements"
            ],
            "properties": {
              "isPublic": {
                "type": "boolean",
                "description": "True allows access without a subject or role grant."
              },
              "requiredEntitlements": {
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128
                },
                "description": "Empty for public policies; one or more for protected policies. Any one matching grant permits access."
              }
            }
          }
        ]
      },
      "RoleEntitlementsRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "roleId",
          "entitlements"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default"
          },
          "entitlements": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 128
            },
            "example": [
              "customers.view"
            ]
          },
          "roleId": {
            "type": "string",
            "format": "uuid",
            "example": "b78650b4-c248-cab1-3d80-9a7c0dad7059"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or incorrect X-Access-Control-Key"
      },
      "ServiceError": {
        "description": "Service or database error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
