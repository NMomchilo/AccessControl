{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "UserManagementRules": {
    "MaximumRolesPerUser": 16,
    "MaximumRoleLength": 64,
    "MaximumEmailLength": 320,
    "MaximumDisplayNameLength": 200
  }
}
