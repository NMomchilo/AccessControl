{
  "openapi": "3.0.3",
  "info": {
    "title": "User Management Service API",
    "version": "5.2.0",
    "description": "Tenant and unit-organization scoped user resolution, roles, and organization administration. The consuming API validates both the user JWT and trusted gateway UO assertion. Client-supplied headers are not trusted organization identity."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as Swagger UI (local HTTP or HTTPS Development profile)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness and database readiness"
    },
    {
      "name": "Client",
      "description": "User resolution and cache revision for consuming services"
    },
    {
      "name": "Administration",
      "description": "Tenant-scoped user and role management"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service liveness",
        "description": "Returns success when the process responds. This endpoint does not check the database.",
        "operationId": "getUserManagementHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service process is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check database readiness",
        "description": "Checks whether the User Management database can be reached. It does not apply migrations.",
        "operationId": "getUserManagementReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Database connection succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ready"
                }
              }
            }
          },
          "503": {
            "description": "Database connection failed"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/users/resolve": {
      "post": {
        "tags": [
          "Client"
        ],
        "summary": "Find or create a tenant-scoped user and return role IDs",
        "description": "Resolve a validated oid in the tenant and gateway-authenticated UO. A missing UO, user, or Reviewer assignment is created idempotently.",
        "operationId": "resolveUser",
        "security": [
          {
            "ClientApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserIdentityRequest"
              },
              "example": {
                "tenantId": "default",
                "objectId": "9155ff4d-2708-4770-b87e-e238645ec5df",
                "email": "user@example.com",
                "displayName": "Example User",
                "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                "unitOrganizationName": "Customer Operations"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User resolved or created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentityResponse"
                },
                "example": {
                  "userId": "70f515ab-3c8d-42ab-92a3-3a06f1f9d938",
                  "tenantId": "default",
                  "isActive": true,
                  "roles": [
                    {
                      "roleId": "b78650b4-c248-cab1-3d80-9a7c0dad7059",
                      "code": "reviewer",
                      "displayName": "Reviewer"
                    }
                  ],
                  "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                  "unitOrganizationName": "Customer Operations"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "409": {
            "description": "UO ID is tombstoned or asserted name conflicts with an existing organization"
          }
        }
      }
    },
    "/v1/users/revision": {
      "get": {
        "tags": [
          "Client"
        ],
        "summary": "Get the shared user, UO, and role revision",
        "description": "Consuming instances poll this value to invalidate cached roles and active status after administrator changes.",
        "operationId": "getUserRoleRevision",
        "security": [
          {
            "ClientApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current revision as a JSON number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "example": 1
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/users/by-email": {
      "get": {
        "tags": ["Administration"],
        "summary": "Find users by email",
        "description": "Returns a page of matching users because email is not a unique identity. Matching ignores letter case. Roles are grouped by active unit-organization membership.",
        "operationId": "findUsersByEmail",
        "security": [{ "AdministratorApiKey": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TenantId" },
          { "name": "email", "in": "query", "required": true, "schema": { "type": "string", "maxLength": 320 } },
          { "name": "unitOrganizationId", "in": "query", "required": false, "schema": { "type": "string", "format": "uuid" } },
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PageSize" }
        ],
        "responses": {
          "200": { "description": "Matching users (empty items when none)", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PagedUsers" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Unit organization not found when filtering by organization" },
          "500": { "$ref": "#/components/responses/ServiceError" }
        }
      }
    },
    "/v1/users/{objectId}": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Get a user by Entra oid",
        "operationId": "getManagedUser",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ObjectId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentityResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No user has this oid"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        },
        "description": "The tenantId query parameter scopes the oid lookup."
      }
    },
    "/v1/users/{objectId}/roles": {
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Replace all of a user's application roles",
        "description": "Replace the complete user role-ID set. Every ID must exist in this user's tenant. An empty array removes all assignments and a successful write increments the cache revision.",
        "operationId": "replaceManagedUserRoles",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ObjectId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceRolesRequest"
              },
              "example": {
                "roleIds": [
                  "b78650b4-c248-cab1-3d80-9a7c0dad7059"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Roles replaced; no response body"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No user has this oid"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/users/{objectId}/active": {
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Activate or deactivate a user",
        "description": "A successful write increments the shared cache revision. Inactive users are denied by the consuming middleware. The tenantId query parameter scopes the oid lookup.",
        "operationId": "setManagedUserActiveStatus",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ObjectId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetActiveRequest"
              },
              "example": {
                "isActive": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status changed; no response body"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No user has this oid"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/roles": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List roles across a tenant or in one UO",
        "operationId": "listRoles",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/OptionalUnitOrganizationId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of roles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedRoles"
                },
                "example": {
                  "items": [
                    {
                      "roleId": "b78650b4-c248-cab1-3d80-9a7c0dad7059",
                      "tenantId": "default",
                      "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                      "code": "reviewer",
                      "displayName": "Reviewer",
                      "isActive": true
                    }
                  ],
                  "totalCount": 1,
                  "page": 1,
                  "pageSize": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "404": {
            "description": "Filtered UO not found or tombstoned"
          }
        },
        "description": "Omit unitOrganizationId for all active UOs, or supply it to filter. Stable order by UO ID, code, and role ID."
      },
      "post": {
        "tags": [
          "Administration"
        ],
        "summary": "Create a UO-scoped role",
        "operationId": "createRole",
        "description": "Code is unique within the tenant and UO. Role IDs are stable for assignments and Access Control grants.",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoleRequest"
              },
              "example": {
                "tenantId": "default",
                "code": "advisor",
                "displayName": "Advisor",
                "unitOrganizationId": "33333333-3333-3333-3333-333333333333"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Role created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleInfo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/unit-organizations": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List unit organizations in a tenant",
        "operationId": "listUnitOrganizations",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Organizations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UnitOrganizationInfo"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "post": {
        "tags": [
          "Administration"
        ],
        "summary": "Create a unit organization",
        "operationId": "createUnitOrganization",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUnitOrganizationRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Organization created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitOrganizationInfo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "409": {
            "description": "Organization ID was tombstoned and cannot be reused"
          }
        }
      }
    },
    "/v1/unit-organizations/{id}": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Get a unit organization",
        "operationId": "getUnitOrganization",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationPathId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitOrganizationInfo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Organization not found"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Rename a unit organization",
        "operationId": "updateUnitOrganization",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationPathId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUnitOrganizationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UnitOrganizationInfo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Organization not found"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "delete": {
        "tags": [
          "Administration"
        ],
        "summary": "Tombstone a unit organization",
        "operationId": "deleteUnitOrganization",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationPathId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "204": {
            "description": "Organization deleted"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Organization not found"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        },
        "description": "Retains users and roles for audit but blocks resolution and role assignment for this UO ID. GET/list omit tombstones. REST create with the same ID returns 409. Already cached resolutions can remain effective for up to five seconds. Clean up Access Control grants and policies separately."
      }
    },
    "/v1/users": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List all users in a tenant",
        "operationId": "listUsers",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "description": "Includes inactive users and roles grouped by active unit-organization membership. Stable order by objectId and userId. Empty items for a page beyond the end.",
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of tenant users",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedUsers"
                },
                "example": {
                  "items": [
                    {
                      "userId": "70f515ab-3c8d-42ab-92a3-3a06f1f9d938",
                      "objectId": "9155ff4d-2708-4770-b87e-e238645ec5df",
                      "displayName": "Example User",
                      "email": "user@example.com",
                      "isActive": true,
                      "memberships": [{ "unitOrganizationId": "33333333-3333-3333-3333-333333333333", "unitOrganizationName": "Customer Operations", "roles": [{ "roleId": "b78650b4-c248-cab1-3d80-9a7c0dad7059", "code": "reviewer", "displayName": "Reviewer", "isActive": true }] }]
                    }
                  ],
                  "totalCount": 1,
                  "page": 1,
                  "pageSize": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/unit-organizations/{id}/users": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List members of an active unit organization",
        "operationId": "listUnitOrganizationUsers",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationPathId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of UO members",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedUsers"
                },
                "example": {
                  "items": [
                    {
                      "userId": "70f515ab-3c8d-42ab-92a3-3a06f1f9d938",
                      "objectId": "9155ff4d-2708-4770-b87e-e238645ec5df",
                      "displayName": "Example User",
                      "email": "user@example.com",
                      "isActive": true,
                      "memberships": [{ "unitOrganizationId": "33333333-3333-3333-3333-333333333333", "unitOrganizationName": "Customer Operations", "roles": [{ "roleId": "b78650b4-c248-cab1-3d80-9a7c0dad7059", "code": "reviewer", "displayName": "Reviewer", "isActive": true }] }]
                    }
                  ],
                  "totalCount": 1,
                  "page": 1,
                  "pageSize": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "404": {
            "description": "UO not found or tombstoned"
          }
        }
      }
    },
    "/v1/unit-organizations/{id}/roles": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List roles in one active unit organization",
        "operationId": "listUnitOrganizationRoles",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/OrganizationPathId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/Page"
          },
          {
            "$ref": "#/components/parameters/PageSize"
          }
        ],
        "responses": {
          "200": {
            "description": "Page of UO roles",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PagedRoles"
                },
                "example": {
                  "items": [
                    {
                      "roleId": "b78650b4-c248-cab1-3d80-9a7c0dad7059",
                      "tenantId": "default",
                      "unitOrganizationId": "33333333-3333-3333-3333-333333333333",
                      "code": "reviewer",
                      "displayName": "Reviewer",
                      "isActive": true
                    }
                  ],
                  "totalCount": 1,
                  "page": 1,
                  "pageSize": 100
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          },
          "404": {
            "description": "UO not found or tombstoned"
          }
        }
      }
    },
    "/v1/roles/{roleId}": {
      "get": {
        "tags": ["Administration"],
        "summary": "Get a role in one tenant and unit organization",
        "operationId": "getRoleById",
        "security": [{ "AdministratorApiKey": [] }],
        "parameters": [
          { "name": "roleId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } },
          { "$ref": "#/components/parameters/TenantId" },
          { "$ref": "#/components/parameters/UnitOrganizationId" }
        ],
        "responses": {
          "200": { "description": "Role", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RoleInfo" } } } },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Role not found in the selected scope" },
          "500": { "$ref": "#/components/responses/ServiceError" }
        }
      }
    },
    "/v1/roles/{roleId}/active": {
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Activate or deactivate a role",
        "operationId": "setRoleActive",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "name": "roleId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/TenantId"
          },
          {
            "$ref": "#/components/parameters/UnitOrganizationId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetActiveRequest"
              },
              "example": {
                "isActive": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status changed; user-resolution caches are invalidated"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Role not found in the selected scope"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ClientApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Management-Key",
        "description": "Credential configured under UserManagementKeys:Clients. Use for resolve and revision only."
      },
      "AdministratorApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Management-Key",
        "description": "Credential configured under UserManagementKeys:Administrators. Use for user read and writes only."
      }
    },
    "parameters": {
      "ObjectId": {
        "name": "objectId",
        "in": "path",
        "required": true,
        "description": "Entra oid; user lookup is scoped by application tenantId.",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "9155ff4d-2708-4770-b87e-e238645ec5df"
      },
      "TenantId": {
        "name": "tenantId",
        "in": "query",
        "required": true,
        "description": "Application tenant, not automatically the Entra tid.",
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "example": "default"
      },
      "UnitOrganizationId": {
        "name": "unitOrganizationId",
        "in": "query",
        "required": true,
        "description": "UO ID within the application tenant.",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "33333333-3333-3333-3333-333333333333"
      },
      "OrganizationPathId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "33333333-3333-3333-3333-333333333333"
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "default": 1
        },
        "example": 1
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "format": "int32",
          "minimum": 1,
          "maximum": 100,
          "default": 100
        },
        "example": 100
      },
      "OptionalUnitOrganizationId": {
        "name": "unitOrganizationId",
        "in": "query",
        "required": false,
        "description": "When omitted, list roles in all active UOs of this tenant.",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "33333333-3333-3333-3333-333333333333"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "UserIdentityRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "objectId",
          "unitOrganizationId",
          "unitOrganizationName"
        ],
        "properties": {
          "objectId": {
            "type": "string",
            "format": "uuid",
            "description": "Validated Entra JWT oid from the consuming service. The User Management service does not validate that JWT."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "maxLength": 320,
            "description": "Optional profile value; never used to match a user."
          },
          "displayName": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default",
            "description": "Application tenant."
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "Stable gateway-asserted organization ID within the application tenant.",
            "example": "33333333-3333-3333-3333-333333333333"
          },
          "unitOrganizationName": {
            "type": "string",
            "maxLength": 200,
            "description": "Gateway-asserted display name; resolution does not rename an existing organization.",
            "example": "Customer Operations"
          }
        }
      },
      "UserIdentityResponse": {
        "type": "object",
        "required": [
          "userId",
          "tenantId",
          "isActive",
          "roles",
          "unitOrganizationId",
          "unitOrganizationName"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Internal User Management identifier."
          },
          "isActive": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRoleInfo"
            },
            "description": "Role IDs and display data. New users receive reviewer."
          },
          "tenantId": {
            "type": "string",
            "example": "default"
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "Stable gateway-asserted organization ID within the application tenant.",
            "example": "33333333-3333-3333-3333-333333333333"
          },
          "unitOrganizationName": {
            "type": "string",
            "maxLength": 200,
            "description": "Gateway-asserted display name; resolution does not rename an existing organization.",
            "example": "Customer Operations"
          }
        }
      },
      "ReplaceRolesRequest": {
        "type": "object",
        "required": [
          "roleIds"
        ],
        "properties": {
          "roleIds": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Complete replacement. Every ID must belong to the selected tenant and UO; [] removes all roles there."
          }
        }
      },
      "SetActiveRequest": {
        "type": "object",
        "required": [
          "isActive"
        ],
        "properties": {
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UserRoleInfo": {
        "type": "object",
        "required": [
          "roleId",
          "code",
          "displayName"
        ],
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "CreateRoleRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "code",
          "displayName",
          "unitOrganizationId"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128
          },
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "Role scope within the tenant.",
            "example": "33333333-3333-3333-3333-333333333333"
          }
        }
      },
      "RoleInfo": {
        "type": "object",
        "required": [
          "roleId",
          "tenantId",
          "code",
          "displayName",
          "unitOrganizationId",
          "isActive"
        ],
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "maxLength": 128
          },
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          },
          "unitOrganizationId": {
            "type": "string",
            "format": "uuid",
            "description": "Role scope within the tenant.",
            "example": "33333333-3333-3333-3333-333333333333"
          },
          "isActive": {
            "type": "boolean",
            "description": "Inactive roles are omitted from resolved user role claims and cannot be assigned."
          }
        }
      },
      "CreateUnitOrganizationRequest": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "33333333-3333-3333-3333-333333333333"
          },
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "Customer Operations"
          }
        }
      },
      "UpdateUnitOrganizationRequest": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "Customer Operations"
          }
        }
      },
      "UnitOrganizationInfo": {
        "type": "object",
        "required": [
          "id",
          "tenantId",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "33333333-3333-3333-3333-333333333333"
          },
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "example": "Customer Operations"
          }
        }
      },
      "UserSummary": {
        "type": "object",
        "required": [
          "userId",
          "objectId",
          "displayName",
          "isActive",
          "email",
          "memberships"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "objectId": {
            "type": "string",
            "format": "uuid",
            "description": "Validated Entra oid."
          },
          "displayName": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "nullable": true
          },
          "isActive": {
            "type": "boolean"
          },
          "memberships": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/UserMembershipSummary" }
          }
        }
      },
      "UserMembershipSummary": {
        "type": "object",
        "required": ["unitOrganizationId", "unitOrganizationName", "roles"],
        "properties": {
          "unitOrganizationId": { "type": "string", "format": "uuid" },
          "unitOrganizationName": { "type": "string" },
          "roles": { "type": "array", "items": { "$ref": "#/components/schemas/UserRoleAssignmentInfo" } }
        }
      },
      "UserRoleAssignmentInfo": {
        "type": "object",
        "required": ["roleId", "code", "displayName", "isActive"],
        "properties": {
          "roleId": { "type": "string", "format": "uuid" },
          "code": { "type": "string" },
          "displayName": { "type": "string" },
          "isActive": { "type": "boolean" }
        }
      },
      "PagedUsers": {
        "type": "object",
        "required": [
          "items",
          "totalCount",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserSummary"
            }
          },
          "totalCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          }
        }
      },
      "PagedRoles": {
        "type": "object",
        "required": [
          "items",
          "totalCount",
          "page",
          "pageSize"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RoleInfo"
            }
          },
          "totalCount": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 1
          },
          "pageSize": {
            "type": "integer",
            "format": "int32",
            "minimum": 1,
            "maximum": 100
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request or oid",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          },
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or wrong credential for this operation"
      },
      "ServiceError": {
        "description": "Service or database error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
