{
  "openapi": "3.0.3",
  "info": {
    "title": "User Management Service API",
    "version": "2.0.0",
    "description": "Tenant-scoped Entra user resolution and role catalog. User Management owns user assignments; Access Control owns entitlement grants. The consuming API validates the JWT before calling resolve and forwards returned role IDs for decisions."
  },
  "servers": [
    {
      "url": "/",
      "description": "Same origin as Swagger UI (local HTTP or HTTPS Development profile)"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness and database readiness"
    },
    {
      "name": "Client",
      "description": "User resolution and cache revision for consuming services"
    },
    {
      "name": "Administration",
      "description": "Tenant-scoped user and role management"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check service liveness",
        "description": "Returns success when the process responds. This endpoint does not check the database.",
        "operationId": "getUserManagementHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "Service process is running",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Check database readiness",
        "description": "Checks whether the User Management database can be reached. It does not apply migrations.",
        "operationId": "getUserManagementReadiness",
        "security": [],
        "responses": {
          "200": {
            "description": "Database connection succeeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                },
                "example": {
                  "status": "ready"
                }
              }
            }
          },
          "503": {
            "description": "Database connection failed"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/users/resolve": {
      "post": {
        "tags": [
          "Client"
        ],
        "summary": "Find or create a tenant-scoped user and return role IDs",
        "description": "The consuming API supplies its application tenant and the validated Entra oid. A new user receives the tenant's reviewer role. The service does not validate the end-user JWT.",
        "operationId": "resolveUser",
        "security": [
          {
            "ClientApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserIdentityRequest"
              },
              "example": {
                "tenantId": "default",
                "objectId": "9155ff4d-2708-4770-b87e-e238645ec5df",
                "email": "user@example.com",
                "displayName": "Example User"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User resolved or created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentityResponse"
                },
                "example": {
                  "userId": "70f515ab-3c8d-42ab-92a3-3a06f1f9d938",
                  "tenantId": "default",
                  "isActive": true,
                  "roles": [
                    {
                      "roleId": "b78650b4-c248-cab1-3d80-9a7c0dad7059",
                      "code": "reviewer",
                      "displayName": "Reviewer"
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/users/revision": {
      "get": {
        "tags": [
          "Client"
        ],
        "summary": "Read the shared role revision",
        "description": "Consuming instances poll this value to invalidate cached roles and active status after administrator changes.",
        "operationId": "getUserRoleRevision",
        "security": [
          {
            "ClientApiKey": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current revision as a JSON number",
            "content": {
              "application/json": {
                "schema": {
                  "type": "integer",
                  "format": "int64",
                  "minimum": 0
                },
                "example": 1
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/users/{objectId}": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "Get a user by Entra oid",
        "operationId": "getManagedUser",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ObjectId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserIdentityResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No user has this oid"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        },
        "description": "The tenantId query parameter scopes the oid lookup."
      }
    },
    "/v1/users/{objectId}/roles": {
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Replace all of a user's application roles",
        "description": "Replace the complete user role-ID set. Every ID must exist in this user's tenant. An empty array removes all assignments and a successful write increments the cache revision.",
        "operationId": "replaceManagedUserRoles",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ObjectId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReplaceRolesRequest"
              },
              "example": {
                "roleIds": [
                  "b78650b4-c248-cab1-3d80-9a7c0dad7059"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Roles replaced; no response body"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No user has this oid"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/users/{objectId}/active": {
      "put": {
        "tags": [
          "Administration"
        ],
        "summary": "Activate or deactivate a user",
        "description": "A successful write increments the shared cache revision. Inactive users are denied by the consuming middleware. The tenantId query parameter scopes the oid lookup.",
        "operationId": "setManagedUserActiveStatus",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/ObjectId"
          },
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetActiveRequest"
              },
              "example": {
                "isActive": false
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Status changed; no response body"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No user has this oid"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    },
    "/v1/roles": {
      "get": {
        "tags": [
          "Administration"
        ],
        "summary": "List roles in an application tenant",
        "operationId": "listRoles",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/TenantId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tenant role catalog",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RoleInfo"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      },
      "post": {
        "tags": [
          "Administration"
        ],
        "summary": "Create a tenant-scoped role",
        "operationId": "createRole",
        "description": "Code is unique within the tenant; display names may be the same. The service generates a stable role ID for later assignments and Access Control grants.",
        "security": [
          {
            "AdministratorApiKey": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRoleRequest"
              },
              "example": {
                "tenantId": "default",
                "code": "advisor",
                "displayName": "Advisor"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Role created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RoleInfo"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "500": {
            "$ref": "#/components/responses/ServiceError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ClientApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Management-Key",
        "description": "Credential configured under UserManagementKeys:Clients. Use for resolve and revision only."
      },
      "AdministratorApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-User-Management-Key",
        "description": "Credential configured under UserManagementKeys:Administrators. Use for user read and writes only."
      }
    },
    "parameters": {
      "ObjectId": {
        "name": "objectId",
        "in": "path",
        "required": true,
        "description": "Entra oid; user lookup is scoped by application tenantId.",
        "schema": {
          "type": "string",
          "format": "uuid"
        },
        "example": "9155ff4d-2708-4770-b87e-e238645ec5df"
      },
      "TenantId": {
        "name": "tenantId",
        "in": "query",
        "required": true,
        "description": "Application tenant, not automatically the Entra tid.",
        "schema": {
          "type": "string",
          "maxLength": 128
        },
        "example": "default"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "UserIdentityRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "objectId"
        ],
        "properties": {
          "objectId": {
            "type": "string",
            "format": "uuid",
            "description": "Validated Entra JWT oid from the consuming service. The User Management service does not validate that JWT."
          },
          "email": {
            "type": "string",
            "nullable": true,
            "maxLength": 320,
            "description": "Optional profile value; never used to match a user."
          },
          "displayName": {
            "type": "string",
            "nullable": true,
            "maxLength": 200
          },
          "tenantId": {
            "type": "string",
            "maxLength": 128,
            "example": "default",
            "description": "Application tenant."
          }
        }
      },
      "UserIdentityResponse": {
        "type": "object",
        "required": [
          "userId",
          "tenantId",
          "isActive",
          "roles"
        ],
        "properties": {
          "userId": {
            "type": "string",
            "format": "uuid",
            "description": "Internal User Management identifier."
          },
          "isActive": {
            "type": "boolean"
          },
          "roles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/UserRoleInfo"
            },
            "description": "Role IDs and display data. New users receive reviewer."
          },
          "tenantId": {
            "type": "string",
            "example": "default"
          }
        }
      },
      "ReplaceRolesRequest": {
        "type": "object",
        "required": [
          "roleIds"
        ],
        "properties": {
          "roleIds": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Complete replacement. Every ID must belong to the user's tenant; [] removes all roles."
          }
        }
      },
      "SetActiveRequest": {
        "type": "object",
        "required": [
          "isActive"
        ],
        "properties": {
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UserRoleInfo": {
        "type": "object",
        "required": [
          "roleId",
          "code",
          "displayName"
        ],
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "CreateRoleRequest": {
        "type": "object",
        "required": [
          "tenantId",
          "code",
          "displayName"
        ],
        "properties": {
          "tenantId": {
            "type": "string",
            "maxLength": 128
          },
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          }
        }
      },
      "RoleInfo": {
        "type": "object",
        "required": [
          "roleId",
          "tenantId",
          "code",
          "displayName"
        ],
        "properties": {
          "roleId": {
            "type": "string",
            "format": "uuid"
          },
          "tenantId": {
            "type": "string",
            "maxLength": 128
          },
          "code": {
            "type": "string",
            "maxLength": 64
          },
          "displayName": {
            "type": "string",
            "maxLength": 200
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request or oid",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          },
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or wrong credential for this operation"
      },
      "ServiceError": {
        "description": "Service or database error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProblemDetails"
            }
          }
        }
      }
    }
  }
}
