{
  "AccessControl": {
    "ServiceUrl": "https://localhost:7219/",
    "ApiKey": "replace-with-decision-key",
    "Module": "customers",
    "RoleIdClaimType": "access_control_role_id",
    "RoleIdentityAuthenticationType": "UserManagement",
    "DefaultTenantId": "default",
    "TimeoutSeconds": 5,
    "ExcludedPaths": ["/health"],
    "CatalogOutputPath": "endpoint-catalog.json"
  },
  "UserManagement": {
    "ServiceUrl": "http://localhost:5220/",
    "AllowInsecureHttpForDevelopment": true,
    "MaximumCachedUsers": 10000,
    "CacheLifetime": "00:00:05",
    "RevisionPollInterval": "00:00:01",
    "TimeoutSeconds": 5
  }
}
