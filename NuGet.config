<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="Shared" value=".packages" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="Shared">
      <package pattern="AccessControl.Client" />
      <package pattern="AccessControl.Contracts" />
      <package pattern="UserManagement.Client" />
      <package pattern="UserManagement.Contracts" />
      <package pattern="Common.Persistence" />
      <package pattern="AdminManagement.Security" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
